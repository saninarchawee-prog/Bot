local HealthBarESPEnabled = false
local HealthBarFolder = Instance.new("Folder", workspace)
HealthBarFolder.Name = "HealthBarESP_Storage"

local function CreateHealthBar(player)
    if player == LocalPlayer or not player.Character then return end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if head and hum then
        local bgGui = Instance.new("BillboardGui")
        bgGui.Name = player.Name .. "_HPBar"
        bgGui.Adornee = head
        bgGui.Size = UDim2.new(4, 0, 0.6, 0)
        bgGui.StudsOffset = Vector3.new(0, 2.5, 0)
        bgGui.AlwaysOnTop = true
        bgGui.Parent = HealthBarFolder

        local frameBG = Instance.new("Frame")
        frameBG.Size = UDim2.new(1, 0, 0.4, 0)
        frameBG.Position = UDim2.new(0, 0, 0.6, 0)
        frameBG.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        frameBG.BorderSizePixel = 0
        frameBG.Parent = bgGui

        local bar = Instance.new("Frame")
        bar.Name = "Bar"
        bar.Size = UDim2.new(math.clamp(hum.Health / hum.MaxHealth, 0, 1), 0, 1, 0)
        bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        bar.BorderSizePixel = 0
        bar.Parent = frameBG

        local textLabel = Instance.new("TextLabel")
        textLabel.Size = UDim2.new(1, 0, 0.6, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        textLabel.TextScaled = true
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.Text = player.Name .. " [" .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth) .. "]"
        textLabel.Parent = bgGui

        hum.HealthChanged:Connect(function(newHealth)
            if bar and textLabel then
                if newHealth ~= newHealth then
                    bar.Size = UDim2.new(1, 0, 1, 0)
                    bar.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
                    textLabel.Text = player.Name .. " [nan%100]"
                elseif newHealth == math.huge then
                    bar.Size = UDim2.new(1, 0, 1, 0)
                    bar.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
                    textLabel.Text = player.Name .. " [inf%100]"
                else
                    local percent = math.clamp(newHealth / hum.MaxHealth, 0, 1)
                    bar.Size = UDim2.new(percent, 0, 1, 0)
                    textLabel.Text = player.Name .. " [" .. math.floor(newHealth) .. "/" .. math.floor(hum.MaxHealth) .. "]"
                    if percent > 0.5 then
                        bar.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                    elseif percent > 0.25 then
                        bar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    else
                        bar.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    end
                end
            end
        end)
    end
end

local function UpdateHealthBarESP()
    for _, item in pairs(HealthBarFolder:GetChildren()) do
        item:Destroy()
    end
    
    if not HealthBarESPEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        CreateHealthBar(player)
    end
end

