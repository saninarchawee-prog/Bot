MainTab:CreateSection("ระบบฮีลตัวเองอัตโนมัติ (Auto Medkit Self)")

local AutoMedkitSelfEnabled = false
local LowHealthThreshold = 50
local AutoMedkitLoop = nil

MainTab:CreateSlider({
   Name = "ตั้งค่า % เลือดตัวเองที่เหลือน้อย (Low Health HP %)",
   Range = {1, 100},
   Increment = 1,
   Suffix = "% HP",
   CurrentValue = 50,
   Flag = "LowHealthThresholdSlider",
   Callback = function(Value)
       LowHealthThreshold = Value
   end,
})

MainTab:CreateToggle({
   Name = "เปิดใช้งาน Auto Medkit เมื่อเลือดตัวเองน้อย",
   CurrentValue = false,
   Flag = "AutoMedkitSelfToggle",
   Callback = function(Value)
       AutoMedkitSelfEnabled = Value

       if AutoMedkitSelfEnabled then
           AutoMedkitLoop = task.spawn(function()
               while AutoMedkitSelfEnabled do
                   task.wait(0.3)

                   if LocalPlayer.Character then
                       local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                       
                       if humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
                           local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
                           
                           if healthPercent <= LowHealthThreshold then
                               local system = LocalPlayer.Character:FindFirstChild("System")
                               local action = system and system:FindFirstChild("Action")
                               
                               if action then
                                   local args = {
                                       "Inventory_Consume",
                                       {
                                           Tool = "Medkit"
                                       }
                                   }
                                   
                                   action:InvokeServer(unpack(args))
                                   
                                   Rayfield:Notify({
                                       Title = "Auto Medkit",
                                       Content = "ใช้ Medkit ฮีลตัวเอง (เลือดเหลือ " .. math.floor(healthPercent) .. "%)",
                                       Duration = 2,
                                   })
                                   
                                   task.wait(1)
                               end
                           end
                       end
                   end
               end
           end)

           Rayfield:Notify({
               Title = "Auto Medkit",
               Content = "เปิดใช้งาน Auto Medkit ฮีลตัวเองเรียบร้อย!",
               Duration = 3,
           })
       else
           if AutoMedkitLoop then
               task.cancel(AutoMedkitLoop)
               AutoMedkitLoop = nil
           end

           Rayfield:Notify({
               Title = "Auto Medkit",
               Content = "ปิดใช้งาน Auto Medkit แล้ว",
               Duration = 3,
           })
       end
   end,
})

