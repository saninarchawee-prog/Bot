MainTab:CreateSection("ปรับแต่งหลอดเลือดส่วนตัว (Customizing Health Bar)")

local CustomHealthBarScreen = nil
local CustomHealthBarConnection = nil

local function RemoveCustomHealthBar()
    if CustomHealthBarConnection then
        CustomHealthBarConnection:Disconnect()
        CustomHealthBarConnection = nil
    end
    if CustomHealthBarScreen then
        CustomHealthBarScreen:Destroy()
        CustomHealthBarScreen = nil
    end
end

local function CreateCustomHealthBar()
    RemoveCustomHealthBar()

    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 5)
    if not playerGui then return end

    CustomHealthBarScreen = Instance.new("ScreenGui")
    CustomHealthBarScreen.Name = "CustomHealthBarGUI"
    CustomHealthBarScreen.ResetOnSpawn = false
    CustomHealthBarScreen.Parent = playerGui

    local frameBG = Instance.new("Frame")
    frameBG.Name = "HealthBG"
    frameBG.Size = UDim2.new(0, 260, 0, 35)
    frameBG.Position = UDim2.new(0.5, -130, 0.85, 0)
    frameBG.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frameBG.BorderColor3 = Color3.fromRGB(60, 60, 60)
    frameBG.BorderSizePixel = 2
    frameBG.Active = true
    frameBG.Draggable = true
    frameBG.Parent = CustomHealthBarScreen

    local bar = Instance.new("Frame")
    bar.Name = "HealthBar"
    bar.Size = UDim2.new(1, -6, 1, -6)
    bar.Position = UDim2.new(0, 3, 0, 3)
    bar.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
    bar.BorderSizePixel = 0
    bar.Parent = frameBG

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "HealthText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Text = "HP: --/--"
    textLabel.Parent = frameBG

    local function UpdateBar()
        if not LocalPlayer.Character then return end
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local hp = hum.Health
        local maxHp = hum.MaxHealth

        if hp ~= hp then
            bar.Size = UDim2.new(1, -6, 1, -6)
            bar.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
            textLabel.Text = "HP: nan%100 (NaN/" .. math.floor(maxHp) .. ")"
        elseif hp == math.huge or hp >= 9e9 then
            bar.Size = UDim2.new(1, -6, 1, -6)
            bar.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
            textLabel.Text = "HP: inf%100 (Inf/" .. math.floor(maxHp) .. ")"
        else
            local percent = math.clamp(hp / maxHp, 0, 1)
            bar.Size = UDim2.new(percent, -6, 1, -6)
            textLabel.Text = "HP: " .. math.floor(hp) .. "/" .. math.floor(maxHp) .. " (" .. math.floor(percent * 100) .. "%)"

            if percent > 0.5 then
                bar.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
            elseif percent > 0.25 then
                bar.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
            else
                bar.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end
        end
    end

    UpdateBar()

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        CustomHealthBarConnection = LocalPlayer.Character:FindFirstChildOfClass("Humanoid").HealthChanged:Connect(UpdateBar)
    end
end

MainTab:CreateToggle({
