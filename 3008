       if NoFallEnabled then
           if lp.Character then
               RemoveFallDamage(lp.Character)
           end

           NoFallConnection = lp.CharacterAdded:Connect(function(newChar)
               if NoFallEnabled then
                   newChar:WaitForChild("Humanoid", 5)
