MainTab:CreateSection("ระบบสปอว์นกลับจุดตาย (Auto Flashback)")

local FlashbackEnabled = false
local LastDeathCFrame = nil

local function SetupFlashback(character)
    if not character then return end
    
    local humanoid = character:WaitForChild("Humanoid", 5)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    
    if humanoid and rootPart then
        humanoid.Died:Connect(function()
            if FlashbackEnabled and rootPart then
                LastDeathCFrame = rootPart.CFrame
                Rayfield:Notify({
                    Title = "Flashback Saved",
                    Content = "บันทึกพิกัดจุดตายเรียบร้อย!",
                    Duration = 2,
                })
            end
        end)
    end
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if FlashbackEnabled then
        SetupFlashback(newCharacter)
        
        if LastDeathCFrame then
            local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 5)
            if newRoot then
                task.wait(0.5)
                newRoot.CFrame = LastDeathCFrame
                Rayfield:Notify({
                    Title = "Auto Flashback",
                    Content = "วาร์ปกลับไปยังจุดที่ตายล่าสุดแล้ว!",
                    Duration = 3,
                })
                LastDeathCFrame = nil
            end
        end
    end
end)

if LocalPlayer.Character then
    SetupFlashback(LocalPlayer.Character)
end

MainTab:CreateToggle({
